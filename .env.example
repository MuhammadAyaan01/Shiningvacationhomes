# Server-only. Set in the runtime environment; never use NEXT_PUBLIC_ for secrets.
# Gmail: enable 2-Step Verification and generate a Google App Password.
ENQUIRY_PROVIDER=gmail
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional: leave blank to receive enquiries in SMTP_USER's inbox.
ENQUIRY_TO=
# Optional alternative: set ENQUIRY_PROVIDER=resend and fill these two values plus ENQUIRY_TO.
RESEND_API_KEY=
ENQUIRY_FROM=
# Exact public HTTPS origin is recommended behind a proxy; no trailing slash.
ENQUIRY_ORIGIN=
# Canonical site URL, not a secret. Set to the final approved public domain.
NEXT_PUBLIC_SITE_URL=https://shiningvacationhomes.com
